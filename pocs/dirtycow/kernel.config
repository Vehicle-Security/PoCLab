# Keep the old Dirty COW race fast and avoid sanitizer noise.
# CONFIG_KASAN is not set
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_OUTLINE is not set
# CONFIG_DEBUG_RODATA is not set
CONFIG_RELOCATABLE=y
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_PROC_FS=y
CONFIG_TMPFS=y

# Dirty COW only needs the MM/VFS path. Keep the 4.x lab kernel small and avoid
# old defconfig targets that are noisy or broken on modern build hosts.
# CONFIG_NUMA is not set
# CONFIG_MODULES is not set
# CONFIG_NETFILTER is not set
# CONFIG_NETFILTER_XTABLES is not set
# CONFIG_NETFILTER_XT_TARGET_TCPMSS is not set
# CONFIG_DRM is not set
# CONFIG_DRM_I915 is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_NFS_FS is not set
# CONFIG_WLAN is not set
