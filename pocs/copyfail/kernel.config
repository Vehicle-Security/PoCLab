# kernel.config – copyfail (CVE-2026-31431)
#
# Enables the AF_ALG AEAD interface and the authencesn template that
# contains the vulnerable out-of-bounds ESN write.

# AF_ALG socket family + AEAD mode (the attack surface)
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_AEAD=y

# authenc / authencesn AEAD templates (authencesn contains the bug)
CONFIG_CRYPTO_AUTHENC=y

# Underlying primitives required by authencesn(hmac(sha256),cbc(aes))
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_AES=y
