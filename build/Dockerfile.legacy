FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=5 update && apt-get install -y \
    build-essential gcc flex bison bc cpio wget xz-utils \
    libelf-dev libssl-dev \
    gcc-x86-64-linux-gnu binutils-x86-64-linux-gnu \
    musl-tools fakeroot \
 && rm -rf /var/lib/apt/lists/*
# Create /usr/lib/x86_64-linux-gnu symlinks for packages that install into
# /usr/x86_64-linux-gnu/lib (arm64 cross-toolchain layout).
# Guard the glob so the step does not fail when the directory is empty.
RUN mkdir -p /usr/lib/x86_64-linux-gnu && \
    if [ -d /usr/x86_64-linux-gnu/lib ] && \
       ls /usr/x86_64-linux-gnu/lib/* >/dev/null 2>&1; then \
        for f in /usr/x86_64-linux-gnu/lib/*; do \
            ln -sf "$f" "/usr/lib/x86_64-linux-gnu/$(basename "$f")"; \
        done; \
    fi
WORKDIR /work
