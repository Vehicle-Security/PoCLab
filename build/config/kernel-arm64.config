# arm64-specific kernel config fragment
# Merged after kernel-common.config
# Target: QEMU -M virt (ARM Virtual Machine)

# PL011 UART – serial console (ttyAMA0)
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# GIC interrupt controller (required by QEMU virt machine)
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y

# PSCI for CPU power management
CONFIG_ARM_PSCI_FW=y

# arm64 timer
CONFIG_ARM_ARCH_TIMER=y

# arm64 KASLR disable
# CONFIG_RANDOMIZE_BASE is not set

# PAN (Privileged Access Never) – arm64 equivalent of SMAP; leave on for realism
# PXN (Privileged Execute Never) – arm64 equivalent of SMEP; leave on for realism

# Performance counter access
CONFIG_ARM_PMU=y
CONFIG_HW_PERF_EVENTS=y
