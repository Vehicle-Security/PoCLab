# Busybox config fragment – appended to defconfig before silentoldconfig
# The critical requirement is static linking (no shared libs in initramfs).

CONFIG_STATIC=y
CONFIG_FEATURE_INSTALLER=y

# ── Shell ─────────────────────────────────────────────────────────────────────
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_FEATURE_SH_HISTFILESIZE=y

# ── Utilities useful in PoC environments ──────────────────────────────────────
CONFIG_DMESG=y
CONFIG_INSMOD=y
CONFIG_RMMOD=y
CONFIG_LSMOD=y
CONFIG_MODPROBE=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_PS=y
CONFIG_TOP=y
CONFIG_ID=y
CONFIG_SLEEP=y
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_FIND=y
CONFIG_HEXDUMP=y
CONFIG_XXD=y
CONFIG_DD=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y

# ── Disable applets that require kernel headers not in the cross-compilation ──
# sysroot (asm/types.h, linux/if.h, linux/if_slip.h).  These are not needed
# for kernel vulnerability research.
CONFIG_IFPLUGD=n
CONFIG_IFENSLAVE=n
CONFIG_FEATURE_IFCONFIG_SLIP=n
