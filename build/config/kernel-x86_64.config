# x86_64-specific kernel config fragment
# Merged after kernel-common.config

# 8250/16550 UART – serial console (ttyS0)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# x86_64 KASLR disable (belt-and-suspenders alongside nokaslr on cmdline)
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RANDOMIZE_MEMORY is not set
