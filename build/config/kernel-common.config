# Common kernel config fragment for PoC / vulnerability research
# Applied to all architectures on top of defconfig.

# ── Debug symbols (required for GDB) ──────────────────────────────────────────
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KPROBES=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y
CONFIG_FRAME_POINTER=y
CONFIG_MAGIC_SYSRQ=y

# ── KASLR disabled (predictable addresses for exploit development) ─────────────
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RANDOMIZE_MEMORY is not set

# ── GDB stub ──────────────────────────────────────────────────────────────────
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y

# ── KASAN – catches UAF / OOB at runtime ──────────────────────────────────────
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
# CONFIG_KASAN_INLINE is not set
CONFIG_KASAN_OUTLINE=y

# ── Heap internals – disable hardening for cleaner exploit primitives ──────────
# CONFIG_SLAB_FREELIST_RANDOM is not set
# CONFIG_SLAB_FREELIST_HARDENED is not set
# CONFIG_SHUFFLE_PAGE_ALLOCATOR is not set

# ── Unprivileged namespaces (required for many modern exploits) ───────────────
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y

# ── BPF (kernel 5.x+ exploit primitives) ──────────────────────────────────────
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=n

# ── Filesystem / device support for initramfs ─────────────────────────────────
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── Virtio (QEMU paravirt devices) ────────────────────────────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SCSI_VIRTIO=y

# ── Crash/panic helpers ────────────────────────────────────────────────────────
CONFIG_PANIC_ON_OOPS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
